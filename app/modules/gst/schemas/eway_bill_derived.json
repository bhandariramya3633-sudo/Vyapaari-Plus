{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "e-Way Bill generation payload (DERIVED, not official)",
  "description": "DERIVED schema modelled on the public NIC e-way bill JSON format: mandatory fields, enums, lengths and patterns as the author understands them. It is NOT the official NIC file. Replace it with the official schema from the e-way bill portal before real use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "supplyType", "subSupplyType", "docType", "docNo", "docDate",
    "fromGstin", "fromAddr1", "fromPlace", "fromPincode", "fromStateCode", "actFromStateCode",
    "toGstin", "toAddr1", "toPlace", "toPincode", "toStateCode", "actToStateCode",
    "transactionType", "totalValue", "totInvValue", "transDistance", "itemList"
  ],
  "definitions": {
    "gstin": {
      "type": "string",
      "pattern": "^(URP|([0][1-9]|[1-2][0-9]|[3][0-8])[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z])$"
    },
    "realGstin": {
      "type": "string",
      "pattern": "^([0][1-9]|[1-2][0-9]|[3][0-8])[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
    },
    "amount": {"type": "number", "minimum": 0},
    "rate": {"type": "number", "minimum": 0, "maximum": 100},
    "date": {"type": "string", "pattern": "^[0-3][0-9]/[0-1][0-9]/[2][0][1-2][0-9]$"},
    "pin": {"type": "integer", "minimum": 100000, "maximum": 999999},
    "stateCode": {"type": "integer", "minimum": 1, "maximum": 99}
  },
  "properties": {
    "supplyType": {"type": "string", "enum": ["O", "I"]},
    "subSupplyType": {"type": "integer", "minimum": 1, "maximum": 12},
    "subSupplyDesc": {"type": "string", "maxLength": 20},
    "docType": {"type": "string", "enum": ["INV", "BIL", "BOE", "CHL", "CNT", "OTH"]},
    "docNo": {"type": "string", "pattern": "^[a-zA-Z0-9/-]{1,16}$"},
    "docDate": {"$ref": "#/definitions/date"},
    "fromGstin": {"$ref": "#/definitions/gstin"},
    "fromTrdName": {"type": "string", "minLength": 1, "maxLength": 100},
    "fromAddr1": {"type": "string", "minLength": 1, "maxLength": 120},
    "fromAddr2": {"type": "string", "minLength": 1, "maxLength": 120},
    "fromPlace": {"type": "string", "minLength": 1, "maxLength": 50},
    "fromPincode": {"$ref": "#/definitions/pin"},
    "fromStateCode": {"$ref": "#/definitions/stateCode"},
    "actFromStateCode": {"$ref": "#/definitions/stateCode"},
    "toGstin": {"$ref": "#/definitions/gstin"},
    "toTrdName": {"type": "string", "minLength": 1, "maxLength": 100},
    "toAddr1": {"type": "string", "minLength": 1, "maxLength": 120},
    "toAddr2": {"type": "string", "minLength": 1, "maxLength": 120},
    "toPlace": {"type": "string", "minLength": 1, "maxLength": 50},
    "toPincode": {"$ref": "#/definitions/pin"},
    "toStateCode": {"$ref": "#/definitions/stateCode"},
    "actToStateCode": {"$ref": "#/definitions/stateCode"},
    "transactionType": {"type": "integer", "minimum": 1, "maximum": 4},
    "totalValue": {"$ref": "#/definitions/amount"},
    "cgstValue": {"$ref": "#/definitions/amount"},
    "sgstValue": {"$ref": "#/definitions/amount"},
    "igstValue": {"$ref": "#/definitions/amount"},
    "cessValue": {"$ref": "#/definitions/amount"},
    "cessNonAdvolValue": {"$ref": "#/definitions/amount"},
    "otherValue": {"type": "number", "minimum": -100000, "maximum": 100000},
    "totInvValue": {"$ref": "#/definitions/amount"},
    "transporterId": {"$ref": "#/definitions/realGstin"},
    "transporterName": {"type": "string", "minLength": 1, "maxLength": 100},
    "transDocNo": {"type": "string", "pattern": "^[a-zA-Z0-9/-]{1,15}$"},
    "transDocDate": {"$ref": "#/definitions/date"},
    "transMode": {"type": "string", "enum": ["1", "2", "3", "4"]},
    "transDistance": {"type": "integer", "minimum": 0, "maximum": 4000},
    "vehicleNo": {"type": "string", "pattern": "^[A-Z]{2}[0-9]{1,2}[A-Z]{0,3}[0-9]{4}$"},
    "vehicleType": {"type": "string", "enum": ["R", "O"]},
    "itemList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productName", "hsnCode", "quantity", "qtyUnit", "taxableAmount"],
        "properties": {
          "productName": {"type": "string", "minLength": 1, "maxLength": 100},
          "productDesc": {"type": "string", "minLength": 1, "maxLength": 100},
          "hsnCode": {"type": "integer", "minimum": 1, "maximum": 99999999},
          "quantity": {"$ref": "#/definitions/amount"},
          "qtyUnit": {"type": "string", "minLength": 3, "maxLength": 8},
          "taxableAmount": {"$ref": "#/definitions/amount"},
          "cgstRate": {"$ref": "#/definitions/rate"},
          "sgstRate": {"$ref": "#/definitions/rate"},
          "igstRate": {"$ref": "#/definitions/rate"},
          "cessRate": {"$ref": "#/definitions/rate"},
          "cessNonadvol": {"$ref": "#/definitions/amount"}
        }
      }
    }
  }
}
