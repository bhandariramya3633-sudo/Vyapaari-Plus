{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "e-Invoice INV-01 version 1.1 (DERIVED, not official)",
  "description": "DERIVED schema modelled on the public NIC e-invoice (INV-01 v1.1) format: mandatory fields, enums, lengths and patterns as the author understands them. It is NOT the official NIC file. Replace it with the official schema from the e-invoice portal before real use.",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "TranDtls", "DocDtls", "SellerDtls", "BuyerDtls", "ItemList", "ValDtls"],
  "definitions": {
    "gstin": {
      "type": "string",
      "pattern": "^([0][1-9]|[1-2][0-9]|[3][0-8])[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
    },
    "stateCode": {"type": "string", "pattern": "^[0-9]{2}$"},
    "amount": {"type": "number", "minimum": 0},
    "yesNo": {"type": "string", "enum": ["Y", "N"]},
    "date": {"type": "string", "pattern": "^[0-3][0-9]/[0-1][0-9]/[2][0][1-2][0-9]$"},
    "docNo": {"type": "string", "pattern": "^[a-zA-Z1-9][a-zA-Z0-9/-]{0,15}$"},
    "pin": {"type": "integer", "minimum": 100000, "maximum": 999999}
  },
  "properties": {
    "Version": {"type": "string", "enum": ["1.1"]},
    "TranDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TaxSch", "SupTyp"],
      "properties": {
        "TaxSch": {"type": "string", "enum": ["GST"]},
        "SupTyp": {"type": "string", "enum": ["B2B", "SEZWP", "SEZWOP", "EXPWP", "EXPWOP", "DEXP"]},
        "RegRev": {"$ref": "#/definitions/yesNo"},
        "EcmGstin": {"$ref": "#/definitions/gstin"},
        "IgstOnIntra": {"$ref": "#/definitions/yesNo"}
      }
    },
    "DocDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Typ", "No", "Dt"],
      "properties": {
        "Typ": {"type": "string", "enum": ["INV", "CRN", "DBN"]},
        "No": {"$ref": "#/definitions/docNo"},
        "Dt": {"$ref": "#/definitions/date"}
      }
    },
    "SellerDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Gstin", "LglNm", "Addr1", "Loc", "Pin", "Stcd"],
      "properties": {
        "Gstin": {"$ref": "#/definitions/gstin"},
        "LglNm": {"type": "string", "minLength": 3, "maxLength": 100},
        "TrdNm": {"type": "string", "minLength": 3, "maxLength": 100},
        "Addr1": {"type": "string", "minLength": 1, "maxLength": 100},
        "Addr2": {"type": "string", "minLength": 1, "maxLength": 100},
        "Loc": {"type": "string", "minLength": 3, "maxLength": 50},
        "Pin": {"$ref": "#/definitions/pin"},
        "Stcd": {"$ref": "#/definitions/stateCode"},
        "Ph": {"type": "string", "minLength": 6, "maxLength": 12},
        "Em": {"type": "string", "minLength": 6, "maxLength": 100}
      }
    },
    "BuyerDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Gstin", "LglNm", "Pos", "Addr1", "Loc", "Pin", "Stcd"],
      "properties": {
        "Gstin": {"$ref": "#/definitions/gstin"},
        "LglNm": {"type": "string", "minLength": 3, "maxLength": 100},
        "TrdNm": {"type": "string", "minLength": 3, "maxLength": 100},
        "Pos": {"$ref": "#/definitions/stateCode"},
        "Addr1": {"type": "string", "minLength": 1, "maxLength": 100},
        "Addr2": {"type": "string", "minLength": 1, "maxLength": 100},
        "Loc": {"type": "string", "minLength": 3, "maxLength": 50},
        "Pin": {"$ref": "#/definitions/pin"},
        "Stcd": {"$ref": "#/definitions/stateCode"},
        "Ph": {"type": "string", "minLength": 6, "maxLength": 12},
        "Em": {"type": "string", "minLength": 6, "maxLength": 100}
      }
    },
    "ItemList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["SlNo", "PrdDesc", "IsServc", "HsnCd", "Unit", "UnitPrice", "TotAmt", "AssAmt", "GstRt", "TotItemVal"],
        "properties": {
          "SlNo": {"type": "string", "minLength": 1, "maxLength": 6},
          "PrdDesc": {"type": "string", "minLength": 1, "maxLength": 300},
          "IsServc": {"$ref": "#/definitions/yesNo"},
          "HsnCd": {"type": "string", "pattern": "^[0-9]{4,8}$"},
          "Barcde": {"type": "string", "minLength": 3, "maxLength": 30},
          "Qty": {"$ref": "#/definitions/amount"},
          "FreeQty": {"$ref": "#/definitions/amount"},
          "Unit": {"type": "string", "minLength": 3, "maxLength": 8},
          "UnitPrice": {"$ref": "#/definitions/amount"},
          "TotAmt": {"$ref": "#/definitions/amount"},
          "Discount": {"$ref": "#/definitions/amount"},
          "PreTaxVal": {"$ref": "#/definitions/amount"},
          "AssAmt": {"$ref": "#/definitions/amount"},
          "GstRt": {"type": "number", "minimum": 0, "maximum": 100},
          "IgstAmt": {"$ref": "#/definitions/amount"},
          "CgstAmt": {"$ref": "#/definitions/amount"},
          "SgstAmt": {"$ref": "#/definitions/amount"},
          "CesRt": {"type": "number", "minimum": 0, "maximum": 100},
          "CesAmt": {"$ref": "#/definitions/amount"},
          "CesNonAdvlAmt": {"$ref": "#/definitions/amount"},
          "StateCesRt": {"type": "number", "minimum": 0, "maximum": 100},
          "StateCesAmt": {"$ref": "#/definitions/amount"},
          "StateCesNonAdvlAmt": {"$ref": "#/definitions/amount"},
          "OthChrg": {"$ref": "#/definitions/amount"},
          "TotItemVal": {"$ref": "#/definitions/amount"}
        }
      }
    },
    "ValDtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AssVal", "TotInvVal"],
      "properties": {
        "AssVal": {"$ref": "#/definitions/amount"},
        "CgstVal": {"$ref": "#/definitions/amount"},
        "SgstVal": {"$ref": "#/definitions/amount"},
        "IgstVal": {"$ref": "#/definitions/amount"},
        "CesVal": {"$ref": "#/definitions/amount"},
        "StCesVal": {"$ref": "#/definitions/amount"},
        "Discount": {"$ref": "#/definitions/amount"},
        "OthChrg": {"$ref": "#/definitions/amount"},
        "RndOffAmt": {"type": "number", "minimum": -99.99, "maximum": 99.99},
        "TotInvVal": {"$ref": "#/definitions/amount"},
        "TotInvValFc": {"$ref": "#/definitions/amount"}
      }
    },
    "RefDtls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "PrecDocDtls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["InvNo", "InvDt"],
            "properties": {
              "InvNo": {"$ref": "#/definitions/docNo"},
              "InvDt": {"$ref": "#/definitions/date"}
            }
          }
        }
      }
    }
  }
}
